<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- L API, les photos et les fonds de carte. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Telecharger dans la galerie : necessaire seulement jusqu a Android 9. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <!-- La position d une photo prise a l instant, et « Pres de moi ». -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- La position inscrite dans les photos de la galerie (lecture EXIF). -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION"/>
    <!-- Retrouver la photo ou la video que l appareil photo du telephone vient d ajouter. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <!-- Les notifications (Firebase) : demandees a partir d Android 13. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Les envois continuent quand on quitte Discover (EnvoisEnFond.kt). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Le retour tout seul apres la prise (une pastille sur l appareil photo), si la personne l autorise. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <application
        android:label="Discover"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/reseau">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Les liens partages (un lieu, une publication, un createur) s ouvrent dans Discover. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="discover.simeonamoussou.com" android:pathPrefix="/l/"/>
                <data android:pathPrefix="/p/"/>
                <data android:pathPrefix="/@"/>
            </intent-filter>
        </activity>
        <service
            android:name=".EnvoisEnFond"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- La carte de Google (Maps SDK) : la cle vient de cles.json (build.gradle.kts). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${cleGoogleMaps}" />
        <!-- Les notifications (Firebase) : le canal « Activité », le logo d une teinte, l ocean. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="activite" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- « Y aller » ouvre l itineraire dans Maps (ou le navigateur). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <!-- « Y aller » : les applications de trajet et de course que l on peut proposer (lib/outils/trajets.dart). -->
        <package android:name="com.google.android.apps.maps"/>
        <package android:name="com.waze"/>
        <package android:name="com.ubercab"/>
        <package android:name="com.gozem"/>
        <package android:name="com.yandex.yango"/>
        <package android:name="com.yango.lite"/>
        <package android:name="sinet.startup.inDriver"/>
        <package android:name="ee.mtakso.client"/>
        <!-- L appareil photo du telephone, en grand (tous ses modes). -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA"/>
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAMERA"/>
        </intent>
        <!-- Le partage : WhatsApp, les SMS et l e-mail du telephone. -->
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="whatsapp"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="smsto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
