APP_NAME=Discover
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Neon (PostgreSQL) : la chaîne de connexion du tableau de bord Neon (« Connection string »,
# avec ?sslmode=require). SQLite reste possible en local : DB_CONNECTION=sqlite.
DB_CONNECTION=pgsql
DB_URL=postgresql://utilisateur:motdepasse@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# La petite base du serveur (file des tâches, cache) : un fichier SQLite à part.
# DB_LOCALE_DATABASE=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Cloudflare R2 : ce que le public voit (DISCOVER_MEDIAS=r2) et, si on les garde, les originaux.
DISCOVER_MEDIAS=r2
DISCOVER_GARDER_ORIGINAUX=false
DISCOVER_ORIGINAUX=r2_prive
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<id-du-compte>.r2.cloudflarestorage.com
R2_BUCKET=discover-medias
R2_URL=https://medias.discover.bj
R2_BUCKET_PRIVE=discover-originaux
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Resend : les codes à 6 chiffres. L'adresse d'envoi doit être sur un domaine vérifié chez Resend.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="codes@discover.bj"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Se connecter avec Google (identifiants clients OAuth, séparés par des virgules).
GOOGLE_CLIENT_IDS=

# Le ré-encodage des reels (B34) : le chemin de ffmpeg ; vide, la vidéo est servie telle quelle.
FFMPEG=
